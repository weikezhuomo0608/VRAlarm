# Android project. Distribute them through GitHub Releases instead.
*.exe
*.msi
*.dll
*backup*.json
*notification-diagnostics*.json
*system-policy*.txt
notification-reports/

# Explicit public distribution assets, also used for GitHub Releases
!release/v1.0.5/ManquAlarm-1.0.5.apk
!release/v1.0.5/ManquAlarm-1.0.5.zip
!release/v1.0.5/ManquAlarm-1.0.5-Public-Source.zip

# Editor and platform files
.DS_Store
Thumbs.db
*.swp

