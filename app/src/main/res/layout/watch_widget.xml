<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#F0181D24"
    android:padding="12dp">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="14sp" android:textStyle="bold" android:textColor="#FFD9E2EA" android:text="主播闹钟"/>
    <TextView android:id="@+id/widget_live" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="13sp" android:textColor="#FFFFC9D4" android:layout_marginTop="4dp" android:text="暂未开播"/>
    <TextView android:id="@+id/widget_next" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="12sp" android:textColor="#FF9FB0BE" android:layout_marginTop="4dp" android:text="周表预告：暂无"/>
    <TextView android:id="@+id/widget_check" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="12sp" android:textColor="#FF7E8F9C" android:layout_marginTop="4dp" android:text="尚未检测"/>
</LinearLayout>
